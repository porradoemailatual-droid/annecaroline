{
  "entities": {
    "Service": {
      "title": "Service",
      "description": "A beauty or salon service offered for booking.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "category": { "type": "string", "minLength": 2, "maxLength": 60 },
        "price": { "type": "number" },
        "durationMinutes": { "type": "integer" },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "imageKey": { "type": "string", "maxLength": 260 },
        "description": { "type": "string", "maxLength": 300 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "price", "durationMinutes", "active", "createdAt", "updatedAt"]
    },
    "Professional": {
      "title": "Professional",
      "description": "A staff member who performs salon services.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "specialty": { "type": "string", "minLength": 2, "maxLength": 100 },
        "avatarInitials": { "type": "string", "minLength": 1, "maxLength": 4 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "avatarKey": { "type": "string", "maxLength": 260 },
        "active": { "type": "boolean" },
        "workDays": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "specialty", "avatarInitials", "active", "workDays", "createdAt", "updatedAt"]
    },
    "BusinessSettings": {
      "title": "BusinessSettings",
      "description": "Global salon working hours, slot interval, closed dates, and header branding.",
      "type": "object",
      "properties": {
        "businessName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "phone": { "type": "string", "maxLength": 30 },
        "address": { "type": "string", "maxLength": 200 },
        "slotIntervalMinutes": { "type": "integer" },
        "weeklySchedule": { "type": "object" },
        "closedDates": { "type": "array" },
        "headerLogoKey": { "type": "string", "maxLength": 260 },
        "headerLogoUrl": { "type": "string", "maxLength": 400 },
        "headerLogoFileName": { "type": "string", "maxLength": 180 },
        "headerLogoMimeType": { "type": "string", "maxLength": 60 },
        "headerLogoSize": { "type": "integer" },
        "headerLogoMode": { "type": "string", "enum": ["logo", "watermark", "both"] },
        "headerWatermarkOpacity": { "type": "integer" },
        "heroBannerKey": { "type": "string", "maxLength": 260 },
        "heroBannerUrl": { "type": "string", "maxLength": 400 },
        "heroBannerSubtitle": { "type": "string", "maxLength": 160 },
        "adminAvatarKey": { "type": "string", "maxLength": 260 },
        "adminAvatarUrl": { "type": "string", "maxLength": 400 },
        "requireAdminConfirmation": { "type": "boolean" },
        "pixFeeEnabled": { "type": "boolean" },
        "pixFeePercentage": { "type": "integer" },
        "pixKeyType": { "type": "string", "enum": ["cpf", "cnpj", "email", "phone", "random"] },
        "pixKey": { "type": "string", "maxLength": 140 },
        "pixBankName": { "type": "string", "maxLength": 80 },
        "pixHolderName": { "type": "string", "maxLength": 80 },
        "pixCity": { "type": "string", "maxLength": 40 },
        "pixProofMode": { "type": "string", "enum": ["receipt_and_confirm", "whatsapp", "both"] },
        "pixWhatsappPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["businessName", "slotIntervalMinutes", "weeklySchedule", "closedDates", "updatedAt"]
    },
    "BusySlot": {
      "title": "BusySlot",
      "description": "Public non-PII occupied or admin-blocked time range.",
      "type": "object",
      "properties": {
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "startTime": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "durationMinutes": { "type": "integer" },
        "professionalId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "kind": { "type": "string", "enum": ["appointment", "blocked"] },
        "ownerId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "appointmentId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 120 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "startTime", "durationMinutes", "professionalId", "kind", "ownerId", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "A booked appointment containing client name, phone, services, date, and status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "clientName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "clientPhone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "phoneHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "maxLength": 64 },
        "cancelToken": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 12, "maxLength": 64 },
        "cancelProof": { "type": "string", "maxLength": 64 },
        "forSomeoneElse": { "type": "boolean" },
        "guestName": { "type": "string", "maxLength": 100 },
        "guestPhone": { "type": "string", "maxLength": 30 },
        "professionalId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "professionalName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "serviceIds": { "type": "array" },
        "serviceNames": { "type": "array" },
        "totalPrice": { "type": "number" },
        "totalDurationMinutes": { "type": "integer" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "startTime": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "notes": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "pixFeePercentage": { "type": "integer" },
        "pixFeeAmount": { "type": "number" },
        "pixPaymentStatus": { "type": "string", "enum": ["not_required", "awaiting_verification", "paid", "rejected"] },
        "pixReceiptKey": { "type": "string", "maxLength": 260 },
        "pixReceiptFileName": { "type": "string", "maxLength": 180 },
        "pixReceiptMimeType": { "type": "string", "maxLength": 80 },
        "confirmedAt": { "type": "string", "maxLength": 40 },
        "confirmedBy": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "clientName",
        "clientPhone",
        "phoneHash",
        "cancelToken",
        "cancelProof",
        "forSomeoneElse",
        "professionalId",
        "professionalName",
        "serviceIds",
        "serviceNames",
        "totalPrice",
        "totalDurationMinutes",
        "date",
        "startTime",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "PhoneLookupBooking": {
      "title": "PhoneLookupBooking",
      "description": "Non-PII booking summary keyed under a client's SHA-256 phone hash for loginless appointment lookup.",
      "type": "object",
      "properties": {
        "appointmentId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "phoneHash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "maxLength": 64 },
        "cancelToken": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 12, "maxLength": 64 },
        "professionalId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "professionalName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "serviceNames": { "type": "array" },
        "totalPrice": { "type": "number" },
        "totalDurationMinutes": { "type": "integer" },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "maxLength": 10 },
        "startTime": { "type": "string", "pattern": "^[0-9]{2}:[0-9]{2}$", "maxLength": 5 },
        "status": { "type": "string", "enum": ["pending", "confirmed", "completed", "cancelled"] },
        "pixFeePercentage": { "type": "integer" },
        "pixFeeAmount": { "type": "number" },
        "pixPaymentStatus": { "type": "string", "enum": ["not_required", "awaiting_verification", "paid", "rejected"] },
        "hasPixReceipt": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "appointmentId",
        "phoneHash",
        "cancelToken",
        "professionalId",
        "professionalName",
        "serviceNames",
        "totalPrice",
        "totalDurationMinutes",
        "date",
        "startTime",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientRecord": {
      "title": "ClientRecord",
      "description": "Admin-managed client CRM record containing contact info and loyalty history.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "phone": { "type": "string", "minLength": 8, "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "notes": { "type": "string", "maxLength": 400 },
        "loyaltyPoints": { "type": "integer" },
        "totalVisits": { "type": "integer" },
        "totalSpent": { "type": "number" },
        "lastVisitDate": { "type": "string", "maxLength": 10 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "phone", "loyaltyPoints", "totalVisits", "totalSpent", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authoritative PIN-activated admin role grant keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "activationProof": { "type": "string", "pattern": "^[a-f0-9]{64}$", "maxLength": 64 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "activationProof", "grantedAt"]
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Metadata-only catalog record for an object stored privately in Cloudflare R2.",
      "type": "object",
      "properties": {
        "fileName": { "type": "string", "minLength": 1, "maxLength": 180 },
        "objectKey": { "type": "string", "minLength": 5, "maxLength": 260 },
        "category": { "type": "string", "enum": ["branding", "services", "profiles", "banners", "gallery", "private"] },
        "mimeType": { "type": "string", "maxLength": 80 },
        "sizeBytes": { "type": "integer" },
        "url": { "type": "string", "maxLength": 400 },
        "uploadedByUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fileName", "objectKey", "category", "mimeType", "sizeBytes", "url", "uploadedByUid", "createdAt", "updatedAt"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Metadata-only public portfolio photo stored in Cloudflare R2.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "caption": { "type": "string", "maxLength": 200 },
        "imageUrl": { "type": "string", "maxLength": 400 },
        "imageKey": { "type": "string", "minLength": 5, "maxLength": 260 },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "imageUrl", "imageKey", "active", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Catalog of beauty salon services publicly viewable and admin-managed."
    },
    "/professionals/{professionalId}": {
      "schema": { "$ref": "#/entities/Professional" },
      "description": "Catalog of salon professionals publicly viewable and admin-managed."
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/BusinessSettings" },
      "description": "Salon configuration document (main) with business hours, closed dates, and header branding metadata."
    },
    "/busySlots/{slotId}": {
      "schema": { "$ref": "#/entities/BusySlot" },
      "description": "Public non-PII schedule availability locks for appointments and admin blocks."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Private appointments created by guests or admins, readable strictly by administrators."
    },
    "/phoneLookups/{phoneHash}/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/PhoneLookupBooking" },
      "description": "Non-PII booking lookup index keyed by SHA-256 hash of normalized phone digits."
    },
    "/clients/{clientId}": {
      "schema": { "$ref": "#/entities/ClientRecord" },
      "description": "Private CRM client directory accessible strictly to administrators."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authoritative admin allowlist activated via server-verified PIN."
    },
    "/mediaAssets/{assetId}": {
      "schema": { "$ref": "#/entities/MediaAsset" },
      "description": "Metadata-only registry of private Cloudflare R2 files managed exclusively by admins."
    },
    "/galleryItems/{itemId}": {
      "schema": { "$ref": "#/entities/GalleryItem" },
      "description": "Publicly viewable salon portfolio gallery metadata pointing to private Cloudflare R2 proxy URLs."
    }
  }
}
