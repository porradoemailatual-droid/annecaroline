rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'porradoemailatual@gmail.com';
    }

    function isActivatedAdmin() {
      return isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isAdmin() {
      return isBootstrappedAdmin() || isActivatedAdmin();
    }

    function isValidActivationProof(proof) {
      return proof is string
        && proof.size() == 64
        && proof.matches('^[a-f0-9]{64}$')
        && hashing.sha256(proof.toUtf8()).toHexString().lower() == '305444592d68ff971933fb0612673aedb18bc6aac676f867c60dd086fdafc810';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPhoneHash(hash) {
      return hash is string && hash.size() == 64 && hash.matches('^[a-f0-9]{64}$');
    }

    function isValidR2ObjectKey(key) {
      return key is string
        && key.size() >= 5
        && key.size() <= 260
        && (
          key.matches('^(branding|services|profiles|banners|gallery)/[a-zA-Z0-9._\\-]+$')
          || key.matches('^private/[a-zA-Z0-9_\\-]+/[a-zA-Z0-9._\\-]+$')
        );
    }

    function isValidPixReceiptKey(key) {
      return key is string
        && key.size() <= 260
        && (key == '' || key.matches('^private/receipts/[a-zA-Z0-9._\\-]+$'));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidService(data) {
      return data.keys().hasAll(['name', 'category', 'price', 'durationMinutes', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'category', 'price', 'durationMinutes', 'imageUrl', 'imageKey', 'description', 'active', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.category is string && data.category.size() >= 2 && data.category.size() <= 60
        && data.price is number && data.price >= 0 && data.price <= 50000
        && data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 480
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 500))
        && (!('imageKey' in data) || (data.imageKey is string && data.imageKey.size() <= 260 && (data.imageKey == '' || isValidR2ObjectKey(data.imageKey))))
        && (!('description' in data) || (data.description is string && data.description.size() <= 300))
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProfessional(data) {
      return data.keys().hasAll(['name', 'specialty', 'avatarInitials', 'active', 'workDays', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'specialty', 'avatarInitials', 'avatarUrl', 'avatarKey', 'active', 'workDays', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.specialty is string && data.specialty.size() >= 2 && data.specialty.size() <= 100
        && data.avatarInitials is string && data.avatarInitials.size() >= 1 && data.avatarInitials.size() <= 4
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500 && (data.avatarUrl == '' || data.avatarUrl.matches('^/api/r2/file\\?key=profiles(%2F|/)[a-zA-Z0-9._\\-]+$'))))
        && (!('avatarKey' in data) || (data.avatarKey is string && data.avatarKey.size() <= 260 && (data.avatarKey == '' || isValidR2ObjectKey(data.avatarKey))))
        && data.active is bool
        && data.workDays is list && data.workDays.size() <= 7
        && (data.workDays.size() == 0 || data.workDays[0] is int)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['businessName', 'slotIntervalMinutes', 'weeklySchedule', 'closedDates', 'updatedAt'])
        && data.keys().hasOnly([
          'businessName', 'phone', 'address', 'slotIntervalMinutes', 'weeklySchedule', 'closedDates',
          'headerLogoKey', 'headerLogoUrl', 'headerLogoFileName', 'headerLogoMimeType', 'headerLogoSize',
          'headerLogoMode', 'headerWatermarkOpacity',
          'heroBannerKey', 'heroBannerUrl', 'heroBannerSubtitle',
          'adminAvatarKey', 'adminAvatarUrl',
          'requireAdminConfirmation', 'pixFeeEnabled', 'pixFeePercentage',
          'pixKeyType', 'pixKey', 'pixBankName', 'pixHolderName', 'pixCity',
          'pixProofMode', 'pixWhatsappPhone',
          'updatedAt'
        ])
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 80
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && data.slotIntervalMinutes is int && data.slotIntervalMinutes >= 10 && data.slotIntervalMinutes <= 120
        && data.weeklySchedule is map && data.weeklySchedule.size() <= 7
        && data.closedDates is list && data.closedDates.size() <= 100
        && (data.closedDates.size() == 0 || (data.closedDates[0] is string && data.closedDates[0].size() <= 10))
        && (!('headerLogoKey' in data) || (data.headerLogoKey is string && data.headerLogoKey.size() <= 260 && (data.headerLogoKey == '' || isValidR2ObjectKey(data.headerLogoKey))))
        && (!('headerLogoUrl' in data) || (data.headerLogoUrl is string && data.headerLogoUrl.size() <= 400 && (data.headerLogoUrl == '' || data.headerLogoUrl.matches('^/api/r2/file\\?key=branding(%2F|/)[a-zA-Z0-9._\\-]+$'))))
        && (!('headerLogoFileName' in data) || (data.headerLogoFileName is string && data.headerLogoFileName.size() <= 180))
        && (!('headerLogoMimeType' in data) || (data.headerLogoMimeType is string && data.headerLogoMimeType.size() <= 60))
        && (!('headerLogoSize' in data) || (data.headerLogoSize is int && data.headerLogoSize >= 0 && data.headerLogoSize <= 5242880))
        && (!('headerLogoMode' in data) || (data.headerLogoMode is string && data.headerLogoMode in ['logo', 'watermark', 'both']))
        && (!('headerWatermarkOpacity' in data) || (data.headerWatermarkOpacity is int && data.headerWatermarkOpacity >= 6 && data.headerWatermarkOpacity <= 35))
        && (!('heroBannerKey' in data) || (data.heroBannerKey is string && data.heroBannerKey.size() <= 260 && (data.heroBannerKey == '' || isValidR2ObjectKey(data.heroBannerKey))))
        && (!('heroBannerUrl' in data) || (data.heroBannerUrl is string && data.heroBannerUrl.size() <= 400 && (data.heroBannerUrl == '' || data.heroBannerUrl.matches('^/api/r2/file\\?key=banners(%2F|/)[a-zA-Z0-9._\\-]+$'))))
        && (!('heroBannerSubtitle' in data) || (data.heroBannerSubtitle is string && data.heroBannerSubtitle.size() <= 160))
        && (!('adminAvatarKey' in data) || (data.adminAvatarKey is string && data.adminAvatarKey.size() <= 260 && (data.adminAvatarKey == '' || isValidR2ObjectKey(data.adminAvatarKey))))
        && (!('adminAvatarUrl' in data) || (data.adminAvatarUrl is string && data.adminAvatarUrl.size() <= 400 && (data.adminAvatarUrl == '' || data.adminAvatarUrl.matches('^/api/r2/file\\?key=profiles(%2F|/)[a-zA-Z0-9._\\-]+$'))))
        && (!('requireAdminConfirmation' in data) || data.requireAdminConfirmation is bool)
        && (!('pixFeeEnabled' in data) || data.pixFeeEnabled is bool)
        && (!('pixFeePercentage' in data) || (data.pixFeePercentage is int && data.pixFeePercentage >= 1 && data.pixFeePercentage <= 100))
        && (!('pixKeyType' in data) || (data.pixKeyType is string && data.pixKeyType in ['cpf', 'cnpj', 'email', 'phone', 'random']))
        && (!('pixKey' in data) || (data.pixKey is string && data.pixKey.size() <= 140))
        && (!('pixBankName' in data) || (data.pixBankName is string && data.pixBankName.size() <= 80))
        && (!('pixHolderName' in data) || (data.pixHolderName is string && data.pixHolderName.size() <= 80))
        && (!('pixCity' in data) || (data.pixCity is string && data.pixCity.size() <= 40))
        && (!('pixProofMode' in data) || (data.pixProofMode is string && data.pixProofMode in ['receipt_and_confirm', 'whatsapp', 'both']))
        && (!('pixWhatsappPhone' in data) || (data.pixWhatsappPhone is string && data.pixWhatsappPhone.size() <= 30))
        && data.updatedAt is timestamp;
    }

    function isValidMediaAsset(data) {
      return data.keys().hasAll([
          'fileName', 'objectKey', 'category', 'mimeType', 'sizeBytes',
          'url', 'uploadedByUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'fileName', 'objectKey', 'category', 'mimeType', 'sizeBytes',
          'url', 'uploadedByUid', 'createdAt', 'updatedAt'
        ])
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 180
        && isValidR2ObjectKey(data.objectKey)
        && data.category is string && data.category in ['branding', 'services', 'profiles', 'banners', 'gallery', 'private']
        && data.mimeType is string && data.mimeType.size() >= 3 && data.mimeType.size() <= 80
        && data.sizeBytes is int && data.sizeBytes >= 1 && data.sizeBytes <= 5242880
        && data.url is string && data.url.size() <= 400 && data.url.matches('^/api/r2/file\\?key=[a-zA-Z0-9._\\-%/]+$')
        && isValidId(data.uploadedByUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidGalleryItem(data) {
      return data.keys().hasAll(['title', 'imageUrl', 'imageKey', 'active', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'caption', 'imageUrl', 'imageKey', 'active', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 80
        && (!('caption' in data) || (data.caption is string && data.caption.size() <= 200))
        && data.imageUrl is string && data.imageUrl.size() <= 400
        && data.imageUrl.matches('^/api/r2/file\\?key=gallery(%2F|/)[a-zA-Z0-9._\\-]+$')
        && isValidR2ObjectKey(data.imageKey)
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBusySlot(data) {
      return data.keys().hasAll(['date', 'startTime', 'durationMinutes', 'professionalId', 'kind', 'ownerId', 'updatedAt'])
        && data.keys().hasOnly(['date', 'startTime', 'durationMinutes', 'professionalId', 'kind', 'ownerId', 'appointmentId', 'reason', 'updatedAt'])
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.durationMinutes is int && data.durationMinutes >= 5 && data.durationMinutes <= 720
        && isValidId(data.professionalId)
        && data.kind in ['appointment', 'blocked']
        && isValidId(data.ownerId)
        && (!('appointmentId' in data) || (data.appointmentId is string && data.appointmentId.size() <= 128))
        && (!('reason' in data) || (data.reason is string && data.reason.size() <= 120))
        && data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
          'userId', 'clientName', 'clientPhone', 'phoneHash', 'cancelToken', 'cancelProof',
          'forSomeoneElse', 'professionalId', 'professionalName', 'serviceIds', 'serviceNames',
          'totalPrice', 'totalDurationMinutes', 'date', 'startTime',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'clientName', 'clientPhone', 'phoneHash', 'cancelToken', 'cancelProof',
          'forSomeoneElse', 'guestName', 'guestPhone', 'professionalId', 'professionalName',
          'serviceIds', 'serviceNames', 'totalPrice', 'totalDurationMinutes',
          'date', 'startTime', 'notes', 'status',
          'pixFeePercentage', 'pixFeeAmount', 'pixPaymentStatus',
          'pixReceiptKey', 'pixReceiptFileName', 'pixReceiptMimeType',
          'confirmedAt', 'confirmedBy',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.clientName is string && data.clientName.size() >= 2 && data.clientName.size() <= 100
        && data.clientPhone is string && data.clientPhone.size() >= 8 && data.clientPhone.size() <= 30
        && isValidPhoneHash(data.phoneHash)
        && data.cancelToken is string && data.cancelToken.size() >= 12 && data.cancelToken.size() <= 64 && data.cancelToken.matches('^[a-zA-Z0-9_\\-]+$')
        && data.cancelProof is string && data.cancelProof.size() <= 64
        && data.forSomeoneElse is bool
        && (!('guestName' in data) || (data.guestName is string && data.guestName.size() <= 100))
        && (!('guestPhone' in data) || (data.guestPhone is string && data.guestPhone.size() <= 30))
        && isValidId(data.professionalId)
        && data.professionalName is string && data.professionalName.size() >= 2 && data.professionalName.size() <= 80
        && data.serviceIds is list && data.serviceIds.size() >= 1 && data.serviceIds.size() <= 10
        && data.serviceIds[0] is string && data.serviceIds[0].size() <= 128
        && data.serviceNames is list && data.serviceNames.size() >= 1 && data.serviceNames.size() <= 10
        && data.serviceNames[0] is string && data.serviceNames[0].size() <= 100
        && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 100000
        && data.totalDurationMinutes is int && data.totalDurationMinutes >= 5 && data.totalDurationMinutes <= 720
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && (!('pixFeePercentage' in data) || (data.pixFeePercentage is int && data.pixFeePercentage >= 0 && data.pixFeePercentage <= 100))
        && (!('pixFeeAmount' in data) || (data.pixFeeAmount is number && data.pixFeeAmount >= 0 && data.pixFeeAmount <= 100000))
        && (!('pixPaymentStatus' in data) || (data.pixPaymentStatus is string && data.pixPaymentStatus in ['not_required', 'awaiting_verification', 'paid', 'rejected']))
        && (!('pixReceiptKey' in data) || isValidPixReceiptKey(data.pixReceiptKey))
        && (!('pixReceiptFileName' in data) || (data.pixReceiptFileName is string && data.pixReceiptFileName.size() <= 180))
        && (!('pixReceiptMimeType' in data) || (data.pixReceiptMimeType is string && data.pixReceiptMimeType.size() <= 80))
        && (!('confirmedAt' in data) || (data.confirmedAt is string && data.confirmedAt.size() <= 40))
        && (!('confirmedBy' in data) || (data.confirmedBy is string && data.confirmedBy.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPhoneLookup(data, phoneHash, bookingId) {
      return data.keys().hasAll([
          'appointmentId', 'phoneHash', 'cancelToken', 'professionalId', 'professionalName',
          'serviceNames', 'totalPrice', 'totalDurationMinutes', 'date', 'startTime',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'appointmentId', 'phoneHash', 'cancelToken', 'professionalId', 'professionalName',
          'serviceNames', 'totalPrice', 'totalDurationMinutes', 'date', 'startTime',
          'status', 'pixFeePercentage', 'pixFeeAmount', 'pixPaymentStatus', 'hasPixReceipt',
          'createdAt', 'updatedAt'
        ])
        && data.appointmentId == bookingId
        && data.phoneHash == phoneHash
        && data.cancelToken is string && data.cancelToken.size() >= 12 && data.cancelToken.size() <= 64 && data.cancelToken.matches('^[a-zA-Z0-9_\\-]+$')
        && isValidId(data.professionalId)
        && data.professionalName is string && data.professionalName.size() >= 2 && data.professionalName.size() <= 80
        && data.serviceNames is list && data.serviceNames.size() >= 1 && data.serviceNames.size() <= 10
        && data.serviceNames[0] is string && data.serviceNames[0].size() <= 100
        && data.totalPrice is number && data.totalPrice >= 0 && data.totalPrice <= 100000
        && data.totalDurationMinutes is int && data.totalDurationMinutes >= 5 && data.totalDurationMinutes <= 720
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.startTime is string && data.startTime.size() == 5 && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.status in ['pending', 'confirmed', 'completed', 'cancelled']
        && (!('pixFeePercentage' in data) || (data.pixFeePercentage is int && data.pixFeePercentage >= 0 && data.pixFeePercentage <= 100))
        && (!('pixFeeAmount' in data) || (data.pixFeeAmount is number && data.pixFeeAmount >= 0 && data.pixFeeAmount <= 100000))
        && (!('pixPaymentStatus' in data) || (data.pixPaymentStatus is string && data.pixPaymentStatus in ['not_required', 'awaiting_verification', 'paid', 'rejected']))
        && (!('hasPixReceipt' in data) || data.hasPixReceipt is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClientRecord(data) {
      return data.keys().hasAll(['name', 'phone', 'loyaltyPoints', 'totalVisits', 'totalSpent', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'phone', 'email', 'notes', 'loyaltyPoints', 'totalVisits', 'totalSpent', 'lastVisitDate', 'createdAt', 'updatedAt'])
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 8 && data.phone.size() <= 30
        && (!('email' in data) || (data.email is string && data.email.size() <= 120))
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 400))
        && data.loyaltyPoints is int && data.loyaltyPoints >= 0 && data.loyaltyPoints <= 100000
        && data.totalVisits is int && data.totalVisits >= 0 && data.totalVisits <= 100000
        && data.totalSpent is number && data.totalSpent >= 0 && data.totalSpent <= 10000000
        && (!('lastVisitDate' in data) || (data.lastVisitDate is string && data.lastVisitDate.size() <= 10))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRecord(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'activationProof', 'grantedAt'])
        && data.keys().hasOnly(['uid', 'email', 'activationProof', 'grantedAt'])
        && data.uid == uid
        && isValidId(data.uid)
        && data.email is string && data.email.size() <= 120
        && isValidActivationProof(data.activationProof)
        && data.grantedAt is timestamp;
    }

    // --- Collection Rules ---

    // Public catalog: Services (no PII) — query must filter where('active', 'in', [true, false])
    match /services/{serviceId} {
      allow get: if isValidId(serviceId);
      allow list: if resource.data.active in [true, false];
      allow create: if isVerified() && isValidId(serviceId)
        && isValidService(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified() && isValidId(serviceId)
        && isValidService(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'category', 'price', 'durationMinutes', 'imageUrl', 'imageKey', 'description', 'active', 'updatedAt']);
      allow delete: if isVerified() && isValidId(serviceId) && isAdmin();
    }

    // Public catalog: Professionals (no PII) — query must filter where('active', 'in', [true, false])
    match /professionals/{professionalId} {
      allow get: if isValidId(professionalId);
      allow list: if resource.data.active in [true, false];
      allow create: if isVerified() && isValidId(professionalId)
        && isValidProfessional(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified() && isValidId(professionalId)
        && isValidProfessional(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'specialty', 'avatarInitials', 'avatarUrl', 'avatarKey', 'active', 'workDays', 'updatedAt']);
      allow delete: if isVerified() && isValidId(professionalId) && isAdmin();
    }

    // Public catalog: Portfolio Gallery (metadata only) — query must filter where('active', 'in', [true, false])
    match /galleryItems/{itemId} {
      allow get: if isValidId(itemId);
      allow list: if resource.data.active in [true, false];
      allow create: if isVerified() && isValidId(itemId)
        && isValidGalleryItem(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified() && isValidId(itemId)
        && isValidGalleryItem(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'caption', 'imageUrl', 'imageKey', 'active', 'updatedAt']);
      allow delete: if isVerified() && isValidId(itemId) && isAdmin();
    }

    // Public catalog: Business Settings (metadata only, no binary blobs)
    match /settings/{settingId} {
      allow get: if settingId == 'main';
      allow create: if isVerified() && settingId == 'main'
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified() && settingId == 'main'
        && isValidSettings(incoming())
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'businessName', 'phone', 'address', 'slotIntervalMinutes', 'weeklySchedule', 'closedDates',
          'headerLogoKey', 'headerLogoUrl', 'headerLogoFileName', 'headerLogoMimeType', 'headerLogoSize',
          'headerLogoMode', 'headerWatermarkOpacity',
          'heroBannerKey', 'heroBannerUrl', 'heroBannerSubtitle',
          'adminAvatarKey', 'adminAvatarUrl',
          'requireAdminConfirmation', 'pixFeeEnabled', 'pixFeePercentage',
          'pixKeyType', 'pixKey', 'pixBankName', 'pixHolderName', 'pixCity',
          'pixProofMode', 'pixWhatsappPhone',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    // Public non-PII occupied/blocked schedule locks — query must filter where('kind', 'in', ['appointment', 'blocked'])
    match /busySlots/{slotId} {
      allow get: if isValidId(slotId);
      allow list: if resource.data.kind in ['appointment', 'blocked'];
      allow create: if isValidId(slotId)
        && isValidBusySlot(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            incoming().kind == 'appointment'
            && incoming().ownerId == 'guest'
            && incoming().appointmentId == slotId
            && existsAfter(/databases/$(database)/documents/appointments/$(slotId))
          )
        );
      allow update: if isValidId(slotId)
        && isValidBusySlot(incoming())
        && incoming().updatedAt == request.time
        && (
          isAdmin() || (
            existing().kind == 'appointment'
            && incoming().kind == 'appointment'
            && incoming().ownerId == existing().ownerId
            && getAfter(/databases/$(database)/documents/appointments/$(slotId)).data.date == incoming().date
            && getAfter(/databases/$(database)/documents/appointments/$(slotId)).data.startTime == incoming().startTime
            && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startTime', 'updatedAt'])
          )
        );
      allow delete: if isValidId(slotId)
        && (
          isAdmin() || (
            existing().kind == 'appointment'
            && getAfter(/databases/$(database)/documents/appointments/$(slotId)).data.status == 'cancelled'
          )
        );
    }

    // Private PII: Appointments
    match /appointments/{appointmentId} {
      allow get: if isVerified() && isValidId(appointmentId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/professionals/$(incoming().professionalId))
        && (
          isAdmin() || (
            incoming().userId == 'guest'
            && incoming().status in ['pending', 'confirmed']
            && incoming().cancelProof == ''
            && (!('pixPaymentStatus' in incoming()) || incoming().pixPaymentStatus in ['not_required', 'awaiting_verification'])
            && (!('confirmedBy' in incoming()) || incoming().confirmedBy == '')
            && (!('confirmedAt' in incoming()) || incoming().confirmedAt == '')
            && existsAfter(/databases/$(database)/documents/busySlots/$(appointmentId))
            && existsAfter(/databases/$(database)/documents/phoneLookups/$(incoming().phoneHash)/bookings/$(appointmentId))
          )
        );
      allow update: if isValidId(appointmentId)
        && isValidAppointment(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().userId == existing().userId
        && incoming().phoneHash == existing().phoneHash
        && incoming().cancelToken == existing().cancelToken
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'clientName', 'clientPhone', 'forSomeoneElse', 'guestName', 'guestPhone',
            'professionalId', 'professionalName', 'serviceIds', 'serviceNames',
            'totalPrice', 'totalDurationMinutes', 'date', 'startTime', 'notes', 'status',
            'pixPaymentStatus', 'confirmedAt', 'confirmedBy', 'updatedAt'
          ])) ||
          (
            !(existing().status in ['completed', 'cancelled'])
            && incoming().cancelProof == existing().cancelToken
            && incoming().status == 'cancelled'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'cancelProof', 'updatedAt'])
          ) ||
          (
            !(existing().status in ['completed', 'cancelled'])
            && incoming().cancelProof == existing().cancelToken
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startTime', 'notes', 'cancelProof', 'updatedAt'])
          )
        );
      allow delete: if isVerified() && isValidId(appointmentId) && isAdmin();
    }

    // Non-PII Phone-Hash Booking Lookup Index — query must filter where('phoneHash', '==', phoneHash)
    match /phoneLookups/{phoneHash} {
      allow read, write: if false;

      match /bookings/{bookingId} {
        allow get: if isValidPhoneHash(phoneHash) && isValidId(bookingId);
        allow list: if isValidPhoneHash(phoneHash) && resource.data.phoneHash == phoneHash;
        allow create: if isValidPhoneHash(phoneHash) && isValidId(bookingId)
          && isValidPhoneLookup(incoming(), phoneHash, bookingId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            isAdmin() || existsAfter(/databases/$(database)/documents/appointments/$(bookingId))
          );
        allow update: if isValidPhoneHash(phoneHash) && isValidId(bookingId)
          && isValidPhoneLookup(incoming(), phoneHash, bookingId)
          && incoming().createdAt == existing().createdAt
          && incoming().cancelToken == existing().cancelToken
          && incoming().updatedAt == request.time
          && (
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
              'date', 'startTime', 'professionalId', 'professionalName',
              'status', 'pixPaymentStatus', 'updatedAt'
            ])) || (
              getAfter(/databases/$(database)/documents/appointments/$(bookingId)).data.status == incoming().status
              && getAfter(/databases/$(database)/documents/appointments/$(bookingId)).data.date == incoming().date
              && getAfter(/databases/$(database)/documents/appointments/$(bookingId)).data.startTime == incoming().startTime
              && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'startTime', 'status', 'updatedAt'])
            )
          );
        allow delete: if isVerified() && isValidPhoneHash(phoneHash) && isValidId(bookingId) && isAdmin();
      }
    }

    // Private PII: Admin CRM Clients
    match /clients/{clientId} {
      allow get: if isVerified() && isValidId(clientId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(clientId)
        && isValidClientRecord(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if isVerified() && isValidId(clientId)
        && isValidClientRecord(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && isAdmin()
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'email', 'notes', 'loyaltyPoints', 'totalVisits', 'totalSpent', 'lastVisitDate', 'updatedAt']);
      allow delete: if isVerified() && isValidId(clientId) && isAdmin();
    }

    // Admin-only metadata registry for Cloudflare R2 private files
    match /mediaAssets/{assetId} {
      allow get: if isVerified() && isValidId(assetId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isVerified() && isValidId(assetId)
        && isValidMediaAsset(incoming())
        && incoming().uploadedByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && isAdmin();
      allow update: if false;
      allow delete: if isVerified() && isValidId(assetId) && isAdmin();
    }

    // Authoritative PIN-Activated Admin Grants
    match /admins/{adminUid} {
      allow get: if isVerified() && isValidId(adminUid) && (isOwner(adminUid) || isBootstrappedAdmin());
      allow list: if isBootstrappedAdmin();
      allow create: if isVerified()
        && isOwner(adminUid)
        && isValidId(adminUid)
        && isValidAdminRecord(incoming(), adminUid)
        && incoming().email == request.auth.token.email
        && incoming().grantedAt == request.time;
      allow update: if false;
      allow delete: if isBootstrappedAdmin() && isValidId(adminUid);
    }
  }
}
